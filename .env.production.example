# Production settings for the VPS. Copy to .env on the server and fill in. Never commit .env.

# PostgreSQL (only reachable inside Docker; use a long random password)
POSTGRES_USER=silktrack
POSTGRES_PASSWORD=
POSTGRES_DB=silktrack

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
# Public URL of the site
AUTH_URL=https://silktrack.example.com

# Caddy: your domain for automatic HTTPS (DNS A record → server IP), or ":80" for plain HTTP on the IP
SITE_ADDRESS=silktrack.example.com

# First admin user (used once by the seed command)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin

# Optional: where scripts/backup.sh writes backups
# BACKUP_DIR=/var/backups/silktrack
