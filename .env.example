# Copy to .env and fill in. Never commit .env.

# PostgreSQL (docker-compose.yml reads POSTGRES_* too)
POSTGRES_USER=silktrack
POSTGRES_PASSWORD=change-me
POSTGRES_DB=silktrack
DATABASE_URL="postgresql://silktrack:change-me@localhost:5432/silktrack?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true

# First admin user, created by `npx prisma db seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now
SEED_ADMIN_NAME=Admin

# Integration tests (separate database; wiped by tests)
DATABASE_URL_TEST="postgresql://silktrack:change-me@localhost:5432/silktrack_test?schema=public"
